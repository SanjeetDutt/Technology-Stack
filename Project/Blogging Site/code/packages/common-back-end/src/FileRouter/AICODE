// src/core/router.ts
import fs from 'fs';
import path from 'path';
import express, { Request, Response, NextFunction, Router } from 'express';

export interface RouteHandler {
  method: string;
  routePath: string;
  handler: Function;
  authenticate?: Function;
  validate?: Function;
  errorHandling?: Function;
}

export function scanRoutes(dir: string, baseRoute = ''): RouteHandler[] {
  let routes: RouteHandler[] = [];
  const entries = fs.readdirSync(dir, { withFileTypes: true });

  for (const entry of entries) {
    const fullPath = path.join(dir, entry.name);

    if (entry.isDirectory()) {
      let folderName = entry.name;
      let nextRoute = baseRoute;

      // Rule 4: Group folder (rounded brackets) -> skip adding to route path
      if (folderName.startsWith('(') && folderName.endsWith(')')) {
        // Keep baseRoute unchanged
      } 
      // Rule 3: Variable folder (square brackets) -> convert to Express :param
      else if (folderName.startsWith('[') && folderName.endsWith(']')) {
        const paramName = folderName.slice(1, -1);
        nextRoute = `${baseRoute}/:${paramName}`;
      } else {
        nextRoute = `${baseRoute}/${folderName}`;
      }

      // TODO: Load folder-level middleware (authenticate, validate, errorHandling) if they exist
      // e.g., check if fullPath + '/authenticate.ts' exists.

      routes = routes.concat(scanRoutes(fullPath, nextRoute));
    } else if (entry.isFile()) {
      const ext = path.extname(entry.name);
      const fileName = path.basename(entry.name, ext);

      // Rule 5: Valid HTTP method files (.ts)
      const validMethods = ['get', 'post', 'put', 'patch', 'delete'];
      if (ext === '.ts' && validMethods.includes(fileName.toLowerCase())) {
        const routePath = baseRoute === '' ? '/' : baseRoute;
        
        // Import module (in production, use dynamic import / compiled JS paths)
        const routeModule = require(fullPath);

        routes.push({
          method: fileName.toLowerCase(),
          routePath,
          handler: routeModule.default,
          authenticate: routeModule.authenticate,
          validate: routeModule.validate,
          errorHandling: routeModule.errorHandling,
        });
      }
    }
  }

  return routes;
}