        <mxCell id="XTloaw65yo6CsO_jb6c2-28" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="&lt;b&gt;Steps to implement Authentication&lt;br&gt;&lt;/b&gt;&lt;ol&gt;&lt;li&gt;Link user with Role and Permission&lt;/li&gt;&lt;ol&gt;&lt;li&gt;While setting up application make some default role and permission&lt;/li&gt;&lt;ol&gt;&lt;li&gt;make a Enum of all the permissions&lt;/li&gt;&lt;li&gt;after DB initiate and before server starts pull the Enums and insert into DB if not exists&lt;/li&gt;&lt;li&gt;This will prevent us to create unnecessary migration scripts&lt;/li&gt;&lt;/ol&gt;&lt;/ol&gt;&lt;li&gt;While generating JWT get all unique permission and put it in the token&lt;/li&gt;&lt;ol&gt;&lt;li&gt;Once the user is validate in the login call&lt;/li&gt;&lt;li&gt;call the db to get role and permissions of the user&lt;/li&gt;&lt;li&gt;from the list of the permission get set of permission&lt;/li&gt;&lt;li&gt;put it in the JWT token&lt;/li&gt;&lt;/ol&gt;&lt;li&gt;Steps to validate the JWT token&lt;/li&gt;&lt;ol&gt;&lt;li&gt;get the jwt token and classifythe header, payload and signature&lt;/li&gt;&lt;li&gt;with partial token (partialToken = header+.+payload) generate a temp signature&lt;/li&gt;&lt;li&gt;check temp signature === actual signature&lt;/li&gt;&lt;/ol&gt;&lt;li&gt;decode the payload and get the list of permissions&amp;nbsp;&lt;/li&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="274" width="514" x="45" y="14" as="geometry" />
        </mxCell>
        <mxCell id="XTloaw65yo6CsO_jb6c2-29" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="&lt;b&gt;Future Enhancements Scope&lt;/b&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Session timeout&lt;/li&gt;&lt;li&gt;Refresh token&lt;/li&gt;&lt;li&gt;Session Id&lt;/li&gt;&lt;li&gt;Active devices&lt;/li&gt;&lt;li&gt;Google integrations&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="178" x="-538" y="302" as="geometry" />
        </mxCell>
        <mxCell id="XTloaw65yo6CsO_jb6c2-30" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="&lt;b&gt;MVP STPES to Impl Authentication&lt;/b&gt;&lt;div&gt;&lt;ol&gt;&lt;li&gt;&lt;i&gt;Make Enum which will have key and description of the Permission&lt;/i&gt;&lt;/li&gt;&lt;li&gt;&lt;i&gt;After DB loads and before Server starts, sync the Permission with the table&lt;/i&gt;&lt;/li&gt;&lt;li&gt;After user validation in login get the list of all permission by joining the Role and permission table&lt;/li&gt;&lt;li&gt;Get set of permission from the list of permission&lt;/li&gt;&lt;li&gt;Add permission key in the token and add permission set to it&lt;/li&gt;&lt;li&gt;Add Iat key and value to the token&amp;nbsp;&lt;/li&gt;&lt;li&gt;In Middleware&amp;nbsp;&lt;/li&gt;&lt;ol&gt;&lt;li&gt;add logic to validate the token&lt;/li&gt;&lt;li&gt;get set of permission from the token&lt;/li&gt;&lt;li&gt;check is all permission is available in the token&lt;/li&gt;&lt;li&gt;If not throw Authentication Error&lt;/li&gt;&lt;li&gt;Else call the next fn&lt;/li&gt;&lt;/ol&gt;&lt;/ol&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="224" width="568" x="-3" y="375" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
